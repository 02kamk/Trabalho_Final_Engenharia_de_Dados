# Copie este arquivo para .env (na raiz do repositório) e preencha com os dados do Azure.
# O .env fica fora do Git. Nunca coloque a chave real neste arquivo de exemplo.

# Azure Data Lake Storage Gen2 (portal do Azure → conta de armazenamento → Chaves de acesso)
AZURE_STORAGE_ACCOUNT=amreclakekm
AZURE_STORAGE_KEY=
AZURE_CONTAINER=datalake-amrec

# A conexão com o Neon fica em outro arquivo, também fora do Git: .env.neon, com a linha
# DATABASE_URL_UNPOOLED=postgresql://usuario:senha@host/banco?sslmode=require
# (ver docs/banco.md)
