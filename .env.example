# Copie este arquivo para .env e preencha com os dados do projeto Supabase.
# O .env está no .gitignore. Nunca commite a senha do banco.
#
# Painel do Supabase > Connect > Connection String > Session pooler (rede IPv4)
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Alternativa: conexão direta (exige IPv6)
# DATABASE_URL=postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
